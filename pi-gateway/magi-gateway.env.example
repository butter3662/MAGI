# 이 파일을 /etc/magi-gateway.env 로 복사한 뒤 값을 채운다.
# 권한: sudo chown root:magigw /etc/magi-gateway.env && sudo chmod 640 /etc/magi-gateway.env

# 문지기가 열 포트 (127.0.0.1 전용). Tailscale Funnel이 이 포트로 넘겨준다.
PORT=8787

# FreeLLMAPI 주소 (같은 파이 안)
UPSTREAM=http://127.0.0.1:3001

# FreeLLMAPI 대시보드 Keys 페이지 위쪽에 있는 통합 키 (freellmapi-로 시작). 절대 GitHub에 올리지 않는다.
FREELLMAPI_KEY=

# MAGI가 쓰는 Supabase 프로젝트 주소와 공개(publishable/anon) 키. MAGI index.html에 이미 들어 있는 값과 같다.
# 이 키는 원래 브라우저에 공개되는 키라 비밀이 아니다. service_role·secret 키는 절대 넣지 않는다.
SUPABASE_URL=https://ictjkqbbcaigdvlysdaw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_C7jZEKJn_nF2Y3Ngq5f80Q_RA5Wrfux

# 개인 서버를 쓸 수 있는 Supabase 사용자 ID (UUID). 여러 개면 쉼표로 구분.
# Supabase 대시보드 → Authentication → Users 에서 내 계정의 UID를 복사한다.
# 비워 두면 모든 요청이 거절되고, 거절 로그에 요청한 계정의 ID가 찍힌다.
ALLOWED_USER_IDS=

# 브라우저 요청을 받을 사이트 주소 (끝에 / 없이)
ALLOWED_ORIGINS=https://butter3662.github.io

# 계정당 분당 최대 요청 수. MAGI 한 번 심의는 최소 7회(1차 3 + 2차 3 + 최종 1)를 호출하고,
# 모델 확인·재시도까지 더해지면 그보다 많아진다.
RATE_PER_MIN=60

# 요청 하나의 최대 크기 (MB). 이미지 첨부를 고려한 값.
MAX_BODY_MB=20
